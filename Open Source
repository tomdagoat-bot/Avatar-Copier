const Players = game:GetService("Players")

const Classes = {Accessory = true, Shirt = true, Pants = true, ShirtGraphic = true, BodyColors = true, CharacterMesh = true}

const Limbs = {"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"}

const Cloths = {"Shirt","Pants","GraphicTShirt"}

const function Get_HD(UserID): HumanoidDescription
	const Success, Obj = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(UserID)
	end)

	if not Success then
		warn("Failed To Get HumanoidDescription:", UserID)
		return
	end

	return Obj
end

const function LoadAsset(AssetID)
	if not AssetID or AssetID == 0 then
		return
	end

	const Objects = game:GetObjects(`rbxassetid://{tostring(AssetID)}`)
	return Objects[1]
end

const function Clear_Appearance(Character)
	for _, Obj in pairs(Character:GetChildren()) do
		if Classes[Obj.ClassName] then
			Obj:Destroy()
		end
	end

	const Head = Character:FindFirstChild("Head")

	if Head then
		for _, Obj in pairs(Head:GetChildren()) do
			if Obj:IsA("Decal") then
				Obj:Destroy()
			end
		end
	end
end

const function Apply_BC(Description,Character)
	const BodyColors = Instance.new("BodyColors")
	const Source = Description.BodyColor or Description

	for _, Limb in pairs(Limbs) do
		const Color = Source[`{Limb}Color`] or Source[Limb]

		if Color then
			BodyColors[`{Limb}Color3`] = Color
		end
	end

	const Old = Character:FindFirstChildOfClass("BodyColors")

	if Old then
		Old:Destroy()
	end

	BodyColors.Parent = Character
end

const function Apply_Cloth(Description,Character)
	const Cloth = Description.Cloth or Description

	for _, ClothType in pairs(Cloths) do
		const Property = ClothType == "GraphicTShirt" and "ShirtGraphic" or ClothType
		const AssetID = Cloth[ClothType] or Cloth[Property]

		if not AssetID or AssetID == 0 then
			continue
		end

		const Obj = LoadAsset(AssetID)

		if not Obj then
			warn("Failed To Load",Property,":",AssetID)
			continue
		end

		Obj.Name = Property
		Obj.Parent = Character
	end
end

const function Apply_Face(Description,Character)
	if not Description.Face or Description.Face == 0 then
		return
	end

	const Head = Character:FindFirstChild("Head")

	if not Head then
		warn("Character Has No Head")
		return
	end

	const Old = Head:FindFirstChildOfClass("Decal")

	if Old then
		Old:Destroy()
	end

	const Face = LoadAsset(Description.Face)

	if not Face or not Face:IsA("Decal") then
		warn("Failed To Load Face:",Description.Face)
		return
	end

	Face.Name = "face"
	Face.Face = Enum.NormalId.Front
	Face.Parent = Head
end

const function Position_Accessory_Fix(Accessory,Character)
	if not Accessory:IsA("Accessory") then
		return
	end

	const Handle = Accessory:FindFirstChild("Handle")

	if not Handle or not Handle:IsA("BasePart") then
		Accessory:Destroy()
		return
	end

	Handle.CanCollide = false
	Handle.Massless = true

	const Acc_Attachment = Handle:FindFirstChildOfClass("Attachment")

	if not Acc_Attachment then
		Accessory:Destroy()
		return
	end

	const Char_Attachment = Character:FindFirstChild(
		Acc_Attachment.Name,
		true
	)

	if not Char_Attachment or not Char_Attachment:IsA("Attachment") then
		Accessory:Destroy()
		return
	end

	Accessory.Parent = Character

	Handle.CFrame = Char_Attachment.WorldCFrame * Acc_Attachment.CFrame:Inverse()

	const weld = Instance.new("Weld")
	weld.Name = "AccessoryWeld"
	weld.Part0 = Char_Attachment.Parent
	weld.Part1 = Handle
	weld.C0 = Char_Attachment.CFrame
	weld.C1 = Acc_Attachment.CFrame
	weld.Parent = Handle

	return Accessory
end

const function Apply_Accessories(Description,Character)
	local List

	if typeof(Description) == "Instance" then
		const Success, Accessories = pcall(function()
			return Description:GetAccessories(true)
		end)

		if not Success or not Accessories then
			warn("Failed To Get Accessories")
			return
		end

		List = Accessories
	else
		List = Description.Accessories

		if not List then
			return
		end
	end

	for _, Info in pairs(List) do
		const AssetID = typeof(Info) == "table" and Info.AssetId or Info

		if AssetID and AssetID ~= 0 then
			const Accessory = LoadAsset(AssetID)

			if Accessory then
				Position_Accessory_Fix(Accessory,Character)
			else
				warn("Failed To Load Accessory:",AssetID)
			end
		end
	end
end

const function MAIN(Character,UserID)
	if not Character then
		Character = Players.LocalPlayer.Character
	end

	local Description

	if typeof(UserID) == "number" then
		print("Cloning",`{Players:GetNameFromUserIdAsync(UserID)}'s Avatar`)

		Description = Get_HD(UserID)

		if not Description then
			return
		end

		Clear_Appearance(Character)
	elseif typeof(UserID) == "table" then
		print("Cloning Custom Avatar")
		Description = UserID

		if not Description.KeepCurrent then
			Clear_Appearance(Character)
		end

		if Description.Hide then
			if Description.Hide == "All" then
				Description.Hide = {
					"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"
				}
			end

			for _, Limb in pairs(Description.Hide) do
				const Part = Character:FindFirstChild(Limb)

				if Part then
					Part.Transparency = 1
					
					Part:GetPropertyChangedSignal("Transparency"):Connect(function()
						if Part.Transparency >= 1 then return end
						Part.Transparency = 1
					end)
				end
			end
		end
	else
		warn("MAIN expected a UserId or appearance table, got:",typeof(UserID))
		return
	end

	Apply_BC(Description,Character)
	Apply_Cloth(Description,Character)
	Apply_Face(Description,Character)
	Apply_Accessories(Description,Character)
end

return MAIN 
